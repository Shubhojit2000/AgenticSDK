# Copy to .env (never commit .env). Free keys only; no billing is needed.
GOOGLE_API_KEY=            # Google AI Studio key (free tier)

# Optional tracing: https://cloud.langfuse.com (create a project, copy its API keys).
# Leave empty to run without tracing; nothing is sent anywhere.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Set to "off" to disable tracing even when the keys above are present.
# AGENTICSDK_TRACING=off
