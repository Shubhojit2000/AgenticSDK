# Image in which agent-written scripts run when AGENTICSDK_SANDBOX=docker. Build once:
#   docker build -f Dockerfile.sandbox -t agenticsdk-sandbox .
# Each script then runs as `docker run --rm --network none --cap-drop ALL --read-only --memory 2g --cpus 2
# --pids-limit 256 -v <workdir>:/work agenticsdk-sandbox python solution.py` (see harness/sandbox.py: docker_command).
# No API keys, no network, no repository code: only the Python libraries a script is allowed to import.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*     && pip install --no-cache-dir numpy pandas scipy scikit-learn lightgbm     && useradd --uid 1000 --no-create-home runner
USER runner
WORKDIR /work
